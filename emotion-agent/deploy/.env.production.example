# 复制为 backend/.env 并按服务器路径修改

APP_ENV=prod
MODEL_PROVIDER=current
# 中文微调完成后切换（需先运行 project/scripts/finetune_agent_chinese.sh）
MODEL_CHECKPOINT_PRESET=agent_chinese
PROJECT_ROOT=/path/to/multimodal/project
MODEL_DEVICE=cuda
MODEL_FAIL_ON_ERROR=true
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_BASE=http://127.0.0.1:11434
LLM_TIMEOUT_SEC=60

ASR_PROVIDER=whisper_api
ASR_WHISPER_API_URL=http://127.0.0.1:9010/v1/audio/transcriptions
ASR_WHISPER_API_MODEL=small
ASR_WHISPER_API_LANGUAGE=zh
ASR_TIMEOUT_SEC=60

# 公网域名（用于 CORS，与 nginx server_name 一致）
CORS_ALLOW_ORIGIN=https://YOUR_DOMAIN

HOST=0.0.0.0
PORT=8000
